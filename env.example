HUGGINGFACE_TOKEN=your_huggingface_token_here

# Standalone mode (default: true) — skips the original Latice SaaS backend
# (app.latice.ai, no longer ours to call) and serves a single local model to
# any api-key/model-id pair, with unlimited quota.
LOCAL_MODE=true
LOCAL_MODEL_REPO_ID=./models/tara-ct2

# Only used when LOCAL_MODE=false (original hosted-backend behavior).
API_BASE_URL=https://app.latice.ai
PRIVATE_SECURED_KEY=your_private_secured_key_here